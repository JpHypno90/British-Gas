            "$value": "{spacing.32}"
          }
        }
      },
      "sm": {
        "horizontalPadding": {
          "$type": "spacing",
          "$value": "{spacing.2xl}"
        },
        "gap": {
          "$type": "spacing",
          "$value": "{spacing.lg}"
        },
        "title": {
          "horizontalPadding": {
            "$type": "spacing",
            "$value": "{spacing.2xl}"
          },
          "verticalPadding": {
            "$type": "spacing",
            "$value": "{spacing.lg}"
          }
        },
        "bottomPadding": {
          "$type": "spacing",
          "$value": "{spacing.lg}"
        },
        "topPadding": {
          "$type": "spacing",
          "$value": "{spacing.lg}"
        }
      }
    }
  },
  "colour": {
    "navMenu": {
      "background": {
        "default": {
          "$type": "color",
          "$value": "{colour.background.container.default}"
