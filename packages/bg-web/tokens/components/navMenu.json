        "verticalPadding": {
          "$type": "spacing",
          "$value": "{spacing.40}"
        },
        "gap": {
          "$type": "spacing",
          "$value": "{spacing.32}"
        },
        "title": {
          "gap": {
            "$type": "spacing",
            "$value": "{spacing.2xl}"
