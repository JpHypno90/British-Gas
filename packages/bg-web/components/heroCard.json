  "colour": {
    "heroCard": {
      "background": {
        "xl": {
          "default": {
            "$type": "color",
            "$value": "linear-gradient(180deg, {colour.primary.dark.navy.4} 0%, {colour.primary.dark.navy.9} 30%, rgba(#0093f5, 0.0) 90%)"
          }
        },
        "sm": {
          "default": {
            "$type": "color",
            "$value": "linear-gradient(180deg, {colour.primary.dark.navy.4} 0%, {colour.primary.dark.navy.9} 51%, rgba(#0093f5, 0.0) 85%)"
          }
